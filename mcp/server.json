{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.aifitnessapi/mcp",
  "title": "AI Fitness API (aifitnessapi.com)",
  "description": "Verified fitness and health API data: HealthKit types, Health Connect mapping, changes, glossary.",
  "version": "0.1.0",
  "websiteUrl": "https://aifitnessapi.com/developers",
  "repository": {
    "url": "https://github.com/nikitastarovzz/aifitnessapi",
    "source": "github",
    "subfolder": "mcp"
  },
  "icons": [
    {
      "src": "https://aifitnessapi.com/icon-192.png",
      "mimeType": "image/png",
      "sizes": ["192x192"]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
