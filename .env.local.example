# Firebase service account — for the signup store (see src/lib/firestore.ts).
# From Firebase console: Project settings → Service accounts → Generate new
# private key. Copy the three values out of the downloaded JSON.
# In Vercel: Settings → Environment Variables, same three names.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Paste the private_key value INCLUDING the \n escapes, wrapped in quotes:
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Resend — activates welcome emails + the digest sender (src/lib/email.ts).
# Requires the sending domain verified at resend.com first.
RESEND_API_KEY=re_xxxxxxxxx
NEWSLETTER_FROM="AIFitnessAPI <hello@aifitnessapi.com>"
